# Standup model configuration.
# Copy to ~/.standup/.env (or %USERPROFILE%\.standup\.env on Windows).

# Insert any model API key.
MODEL_API_KEY=

# MODEL_NAME=
# List of model names, this is optional:
#   Anthropic: claude-opus-5, claude-sonnet-5, claude-haiku-5
#   Gemini:    gemini-flash-lite-latest, gemini-flash-latest, gemini-pro-latest
#   OpenAI:    gpt-4o-mini, gpt-4o, gpt-4.1, gpt-4.1-mini

# Optional — an OpenAI-compatible endpoint or gateway (Ollama, LM Studio, vLLM,
# OpenRouter, ...). For a local server with no key, also set LLM_PROVIDER=openai.
# MODEL_BASE_URL=
# LLM_PROVIDER=openai

# Optional — request bounds.
# LLM_MAX_TOKENS=8192
# LLM_MAX_CONCURRENCY=8
# LLM_TIMEOUT_SECONDS=120

# Optional — where projects, chat, decks, and indexes live (absolute path).
# DATA_DIR=
