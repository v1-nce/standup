# Standup model configuration.
# Copy to ~/.standup/.env — the file `standup` reads at startup.

# One provider key is enough. With several set and LLM_PROVIDER empty, precedence
# is anthropic > gemini > openai.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional — pick the provider and model explicitly.
# LLM_PROVIDER=anthropic | gemini | openai
# LLM_MODEL=                 # model id; empty means the provider's default

# Optional — an OpenAI-compatible endpoint or gateway (Ollama, LM Studio, vLLM,
# OpenRouter, Groq, ...). Set LLM_PROVIDER=openai, OPENAI_API_KEY, and LLM_MODEL,
# then point this at the server.
# LLM_BASE_URL=

# Optional — request bounds.
# LLM_MAX_TOKENS=8192
# LLM_MAX_CONCURRENCY=8
# LLM_TIMEOUT_SECONDS=120

# Optional — where projects, chat, decks, and indexes live (absolute path).
# DATA_DIR=
